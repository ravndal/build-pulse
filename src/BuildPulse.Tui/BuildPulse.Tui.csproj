<Project Sdk="Microsoft.NET.Sdk">

  <!-- The terminal app: the dashboard and approvals in a terminal pane, sized for tmux splits.
       Polling, API clients and settings live in src/Shared; only the terminal UI lives here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>buildpulse-tui</AssemblyName>
    <RootNamespace>BuildPulse</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
