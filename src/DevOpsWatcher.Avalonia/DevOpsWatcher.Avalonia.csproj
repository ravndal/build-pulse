<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform (macOS, Windows, Linux) prototype of the tray app on Avalonia.
       Polling, API clients and settings are shared with the WinForms app; only the UI lives here. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DevOpsWatcher</AssemblyName>
    <RootNamespace>DevOpsWatcher</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <AvaloniaResource Include="..\..\assets\app.png" Link="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- Only for the screenshots switch, which renders the dashboard off-screen. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>

</Project>
