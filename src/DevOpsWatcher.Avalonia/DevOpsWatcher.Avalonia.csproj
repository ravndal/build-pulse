<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tray app for Windows, macOS and Linux, on Avalonia.
       Polling, API clients and settings live in src/Shared; only the UI lives here. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DevOpsWatcher</AssemblyName>
    <RootNamespace>DevOpsWatcher</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Published executable: trim unused framework code and compress the single file (win-x64 ~104 MB -> ~23 MB). -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <AvaloniaResource Include="..\..\assets\app.png" Link="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- Only for the screenshots switch, which renders the dashboard off-screen. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>

</Project>
