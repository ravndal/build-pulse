<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>DevOpsWatcher</AssemblyName>
    <RootNamespace>DevOpsWatcher</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <!-- The cross-platform (Avalonia) app lives in its own project and links the shared files from here. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);avalonia\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Published exe: trim unused framework code and compress the single file (~116 MB -> ~17 MB).
       WinForms isn't officially trim-supported, hence the suppression; JSON uses source generation to stay trim-safe. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- assets/make-icon.cs is a standalone file-based app that regenerates app.ico; see its header. -->
    <Compile Remove="assets\**" />
    <EmbeddedResource Include="assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
